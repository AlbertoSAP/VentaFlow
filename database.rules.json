{"rules":{"clienteIndex":{"$cid":{".read":"auth != null && auth.uid == $cid",".write":"auth != null && (newData.val() == auth.uid || data.val() == auth.uid)"}},"clientes":{"$cid":{".read":"auth != null && (auth.uid == $cid || auth.uid == data.child('idAuthVendedor').val())",".write":"auth != null && (auth.uid == newData.child('idAuthVendedor').val() || (data.exists() && auth.uid == data.child('idAuthVendedor').val()))"},".indexOn":["idAuthVendedor"],".read":"query.orderByChild == 'idAuthVendedor' && query.equalTo == auth.uid"},"vendedores":{"$uid":{".read":"auth != null && auth.uid == $uid",".write":"auth != null && auth.uid == $uid"}}}}